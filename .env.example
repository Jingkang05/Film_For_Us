# Server-only. Copy to ignored .env for local development.
APP_ORIGIN=http://127.0.0.1:4173
# Keep legacy until verified migration. No automatic fallback after cutover.
ALBUM_DATA_PROVIDER=legacy
STORAGE_PROVIDER=r2
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect > Transaction pooler. URL-encode the database password.
DATABASE_URL=
# Must match VERCEL_ENV; local uses development.
SUPABASE_ENVIRONMENT=development
# Film For Us production project; never use this ref in Development/Preview URL.
SUPABASE_PRODUCTION_REF=lppysxtcvuphvynrvtyr
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENVIRONMENT=development
STORAGE_WRITE_FREEZE=false
